# ── Supabase (WhatsApp paneli + CRM aynı proje) ──
NEXT_PUBLIC_SUPABASE_URL=https://<proje-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-veya-publishable-key>
# SADECE sunucu. Asla NEXT_PUBLIC_ ile başlatma, istemciye gönderme.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── CRM ──
# MFA zorunlu roller (virgülle). Varsayılan: super_admin
CRM_MFA_ROLES=super_admin

# ── WhatsApp paneli ──
OPENAI_API_KEY=<openai-key>
ADMIN_PASSWORD=<guclu-bir-sifre>
SLACK_BOT_TOKEN=<xoxb-...>
SLACK_CHANNEL_ID=<C...>
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<vapid-public>
VAPID_PRIVATE_KEY=<vapid-private>
MERT_GSM=<905xxxxxxxxx>

# ── CRM entegrasyonları ──
# Webhook imza sırları. İsimleri CRM > Entegrasyonlar ekranındaki "Gizli değişken adı" alanına yazılır;
# değerler yalnızca burada/Vercel'de durur, veritabanına yazılmaz. Adres: /api/crm/webhooks/<kod>
CRM_WEBHOOK_SECRET_ERP=<uzun-rastgele-sir>
CRM_WEBHOOK_SECRET_POS=<uzun-rastgele-sir>
CRM_WEBHOOK_SECRET_ECOMMERCE=<uzun-rastgele-sir>
